#!/bin/sh
# Pre-push: the fast script tests (`node --test scripts/tests/`), the same step CI's hygiene job runs.
# The mod's own gates run in the pre-commit hook and in CI. Install once with scripts/setup.sh (it sets
# core.hooksPath to .githooks). Skip deliberately with `git push --no-verify`; CI runs the same tests.

set -u
cd "$(git rev-parse --show-toplevel)" || exit 2

if ! command -v node >/dev/null 2>&1; then
  echo "pre-push: node not found, so the script tests were not run (CI runs them)" >&2
  exit 0
fi

exec node --test scripts/tests/
