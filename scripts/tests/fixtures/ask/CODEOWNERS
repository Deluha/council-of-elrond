/mods/council-of-elrond/hooks/redact.ts                  @owner
/mods/council-of-elrond/hooks/members/gollum.ts          @owner
/mods/council-of-elrond/.claude-plugin/plugin.json       @owner
/.claude-plugin/marketplace.json                         @owner
/.github/**                                              @owner
/.githooks/**                                            @owner
/scripts/**                                              @owner
/SECURITY.md                                             @owner
/LICENSE                                                 @owner
/.claude/settings.json                                   @owner

