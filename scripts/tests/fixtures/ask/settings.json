{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node scripts/verify.mjs:*)",
      "Bash(node scripts/check-guidance.mjs:*)",
      "Bash(scripts/check-hygiene.sh:*)",
      "Bash(bash scripts/check-hygiene.sh:*)",
      "Bash(tsc -p mods)",
      "Bash(node --test scripts/tests/:*)"
    ],
    "ask": [
      "Edit(/mods/council-of-elrond/hooks/rules/**)",
      "Edit(/mods/council-of-elrond/hooks/config/defaults.ts)",
      "Edit(/mods/council-of-elrond/hooks/config/trust.ts)",
      "Edit(/mods/council-of-elrond/hooks/config/schema.ts)",
      "Edit(/mods/council-of-elrond/hooks/redact.ts)",
      "Edit(/mods/council-of-elrond/hooks/members/gollum.ts)",
      "Edit(/mods/council-of-elrond/.claude-plugin/plugin.json)",
      "Edit(/.claude-plugin/marketplace.json)",
      "Edit(/.github/**)",
      "Edit(/.githooks/**)",
      "Edit(/scripts/**)",
      "Edit(/SECURITY.md)",
      "Edit(/LICENSE)",
      "Edit(/.claude/settings.json)"
    ],
    "deny": [
      "Agent(Explore)",
      "Edit(/mods/types/claude-code.d.ts)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/lint-edited.mjs",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR\"/scripts/hooks/session-start.sh",
            "timeout": 300
          }
        ]
      }
    ]
  }
}
